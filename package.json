{
  "name": "cloudflare-vite-get-started",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "bash scripts/test.sh",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "migrate": "wrangler d1 migrations",
    "cf-typegen": "wrangler types",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "update:effect": "git subtree pull --prefix=repos/effect https://github.com/Effect-TS/effect.git main --squash"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@effect/language-service": "^0.87.1",
    "@effect/sql-sqlite-node": "4.0.4",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.4",
    "@types/node": "^25.9.1",
    "@types/phc__format": "^1.0.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "7.0.2",
    "vite": "^8.0.14",
    "vitest": "5.0.4",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.4",
    "@phc/format": "^1.0.0",
    "effect": "4.0.4",
    "jose": "^6.2.3"
  }
}
