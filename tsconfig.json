{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true, //needed for effect schema
        "exactOptionalPropertyTypes": true, //needed for effect schema
        "skipLibCheck": true,
        "lib": ["ESNext"],
        "types": [
            "./worker-configuration.d.ts",
            "node",
            "vite/client",
            // "typed-htmx",
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "paths": {
            "@/*": ["./src/*"],
            // "@tests/*": ["./src/tests/*"]
        },
    },
}
