{
    "$schema": "./node_modules/@effect/language-service/schema.json",
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true, //needed for effect schema
        "exactOptionalPropertyTypes": true, //needed for effect schema
        "skipLibCheck": true,
        "lib": ["ESNext"],
        "types": [
            "./worker-configuration.d.ts",
            "node",
            "vite/client",
            // "typed-htmx",
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "paths": {
            "@/brands": ["src/db/schema/brands.ts"],
            "@/*": ["./src/*"],
            // "@tests/*": ["./src/tests/*"]
        },
        "plugins": [
            // ... other LSPs (if any) and as last
            {
                "name": "@effect/language-service",
            },
        ],
    },
}
