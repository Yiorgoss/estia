{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "estia-effect",
  // Set this to today's date
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "./src/app.ts",
  "assets": { "directory": "static" },
  "vars": {
    "ORIGIN": "localhost:5173",
    // The placeholder Greece cutout. `PMTILES_GREECE` names the archive the page
    // reads; point it at any PMTiles URL to swap the archive you supply without
    // a code change.
    "PMTILES_GREECE": "/maps/greece.pmtiles",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estia-db-test",
      "database_id": "1e3085db-a5ff-432b-b2d4-7135906f87f0",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "estia",
      // "remote": true,
    },
  ],
  // The Images binding is the codec that turns a validated upload into the
  // downscaled card image. Local development serves it from the same workerd
  // runtime the app already uses.
  "images": {
    "binding": "IMAGES",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHATS",
        "class_name": "Chat",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat"],
    },
  ],
  "env": {
    "test": {
      // The shared test deployment. `estia.calisto.studio` is the one remote
      // host `pnpm seed:test` may write to (`scripts/seed.mjs` names it), so a
      // test deploy and its seed data always agree on where they live.
      "routes": [{ "pattern": "estia.calisto.studio", "custom_domain": true }],
      "vars": {
        // `src/app.ts` reads this through its config literal. `test` is not the
        // production branch, so the test deploy keeps the permissive CORS list
        // rather than the production allowlist.
        "ENVIRONMENT": "test",
        // The bare-hostname form `ORIGIN` already uses in this file. Nothing in
        // `src/` reads it today; it names the host the deployment is served on.
        "ORIGIN": "estia.calisto.studio",
        // The same placeholder archive the top-level config names.
        "PMTILES_GREECE": "/maps/greece.pmtiles",
      },
      // Bindings are not inherited by a named environment, so the test
      // environment repeats the database, the bucket, the codec, and the chat
      // Durable Object the top-level config binds.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "estia-db-test",
          "database_id": "1e3085db-a5ff-432b-b2d4-7135906f87f0",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "estia",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CHATS",
            "class_name": "Chat",
          },
        ],
      },
    },
    "prod": {
      "vars": {
        "ENVIRONMENT": "prod",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "estia-db-prod",
          "database_id": "20f662db-bd64-4ac4-b2ad-e8024d30d55f",
          "migrations_dir": "src/db/migrations",
        },
      ],
      // Bindings are not inherited by a named environment, so the prod
      // environment repeats the bucket the map archive and listing photos use.
      // The bucket must exist in the deploying account before `wrangler deploy`.
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "estia",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CHATS",
            "class_name": "Chat",
          },
        ],
      },
    },
  },
}
