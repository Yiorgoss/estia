{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "estia-effect",
  // Set this to today's date
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "./src/app.ts",
  "assets": { "directory": "static" },
  "vars": {
    "ORIGIN": "localhost:5173",
    // The placeholder Greece cutout. `PMTILES_GREECE` names the archive the page
    // reads; point it at any PMTiles URL to swap the archive you supply without
    // a code change.
    "PMTILES_GREECE": "/maps/greece.pmtiles",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estia-db-test",
      "database_id": "1e3085db-a5ff-432b-b2d4-7135906f87f0",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "estia",
      // "remote": true,
    },
  ],
  // The Images binding is the codec that turns a validated upload into the
  // downscaled card image. Local development serves it from the same workerd
  // runtime the app already uses.
  "images": {
    "binding": "IMAGES",
  },
  "env": {
    "prod": {
      "vars": {
        "ENV": "prod",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "estia-db-prod",
          "database_id": "20f662db-bd64-4ac4-b2ad-e8024d30d55f",
          "migrations_dir": "src/db/migrations",
        },
      ],
      // Bindings are not inherited by a named environment, so the prod
      // environment repeats the bucket the map archive and listing photos use.
      // The bucket must exist in the deploying account before `wrangler deploy`.
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "estia",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
    },
  },
}
